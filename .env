# .env
# se você abriu esse arquivo procurando segredos, senhas ou API keys...
# encontrou um segredo mesmo. só que é de cozinha 🍟

RECEITA="Batata Frita Perfeita (dupla fritura)"

INGREDIENTES_QTD=4
INGREDIENTES="batatas grandes, óleo o suficiente pra fritura, sal a gosto, pimenta do reino (opcional)"

PASSO_1="Descasque as batatas e corte em palitos uniformes de ~1cm."
PASSO_2="Deixe de molho em água fria por 30 min pra tirar o excesso de amido."
PASSO_3="Seque bem cada palito com pano ou papel toalha. Batata molhada não frita, ela cozinha no vapor do próprio óleo."
PASSO_4="Primeira fritura: óleo a 160°C por 5-6 min, até ficarem macias e ainda pálidas. Retire e escorra bem."
PASSO_5="Deixe descansar 10 min em temperatura ambiente. Esse descanso é o segredo da crocância."
PASSO_6="Segunda fritura: óleo bem quente, 190°C, por 2-3 min, até dourar."
PASSO_7="Escorra, tempere com sal na hora (nunca antes) e sirva imediatamente."

NIVEL_CROCANCIA=100
APROVACAO_DA_FAMILIA=true
SEGREDO_REVELADO=true

# fim da receita. bom apetite 🍟
